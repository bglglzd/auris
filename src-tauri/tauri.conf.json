{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memiro AI",
  "mainBinaryName": "Memiro",
  "version": "0.14.0",
  "identifier": "com.3uxo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Memiro AI",
        "width": 1120,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPDATA/../**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "upgradeCode": "1e80fb85-5177-5635-8650-55fc18e718a0"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bglglzd/auris/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4RjU5NjU2Q0YzRTBFQzUKUldURkRqN1BWcGIxaUZDOFRwTldtZGRNKy9NVmtIejhSYUY0TVZlYmZNZFNhcmsxVGU4YThiTXcK"
    }
  }
}
